## hei-fastapi-ddd environment example
##
## Keep only deployment/infrastructure settings here.
## Runtime business settings are managed in DB sys_config (UPPER_SNAKE keys):
## - AUTH_* / PASSWORD_* / MAIL_* / SMS_* / PUSH_* / AUDIT_ALERT_* / STORAGE_* / COPYRIGHT_*
#
#APP__HOST=127.0.0.1
#APP__PORT=8000
#APP__DEBUG=true
## APP__CONFIG_CRYPTO_KEY=  # required in production (Fernet); used for config + storage AK/SK + file URL signing
## SWAGGER__ENABLED=false   # keep disabled in production
## ID_GENERATOR__WORKER_ID=0  # 0 = auto from hostname/pid; set 1-31 to pin
## AUTH__SESSION_IDLE_TIMEOUT_SECONDS=1800  # 0=disabled; compose defaults to 1800
## AUTH__SESSION_COOKIE_ENABLED=true
## AUTH__SESSION_COOKIE_SECURE=true  # require HTTPS in production
## AUTH__SESSION_COOKIE_SAMESITE=lax
## AUTH__IM_TICKET_TTL_SECONDS=120
## SECRETS__BACKEND=fernet  # or vault
## SECRETS__REQUIRE_VAULT=false
## SECRETS__ALLOW_FERNET_IN_PROD=true  # set false in hardened prod to force Vault
## SECRETS__VAULT_ADDR=http://127.0.0.1:8200
## SECRETS__VAULT_TOKEN=
## SECRETS__VAULT_MOUNT=secret
## SECRETS__VAULT_PATH=hei/fernet
## SECRETS__VAULT_KEY_FIELD=fernet_key
#APP__CONFIG_CRYPTO_KEY=
#APP__TIMEZONE=Asia/Shanghai
#APP__TRUSTED_PROXY_IPS=[]
#DOCKER_TRUSTED_PROXY_IPS=["172.16.0.0/12","127.0.0.1"]
#
#CORS__ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5163","http://127.0.0.1:5163","http://localhost:5174","http://127.0.0.1:5174"]
#
## Extra auth-exempt API paths (merged with built-in whitelist). Supports fnmatch (* ?).
## AUTH__AUTH_WHITELIST=["/api/v1/portal/sys/banners/list","/api/v1/custom/*"]
#
## Object storage defaults (MinIO/RustFS/OSS/COS). Bucket public flag via sys_config STORAGE_*_BUCKET_PUBLIC.
## STORAGE__PROVIDER=minio
## STORAGE__BUCKET=
## STORAGE__ENDPOINT=
## STORAGE__BUCKET_PUBLIC=false
#
## Logging / observability (structlog)
## OBSERVABILITY__LOG_ENABLED=true
## OBSERVABILITY__LOG_LEVEL=INFO
## Structured JSON logs (structlog JSONRenderer): OBSERVABILITY__LOG_JSON=true
## OBSERVABILITY__LOG_DIR=logs
## Leave LOG_DIR empty for stdout-only (typical containers): OBSERVABILITY__LOG_DIR=
## OBSERVABILITY__LOG_FILE_MAX_MB=100
## OBSERVABILITY__SERVICE_NAME=hei-fastapi-ddd
## OBSERVABILITY__ENVIRONMENT=dev
#
#DB__URL=mysql+aiomysql://root:123456@127.0.0.1:3306/hei_fastapi?charset=utf8mb4
## Pytest uses DB__URL by default (optional TEST_DB__URL override). Tests never drop tables.
## PostgreSQL (dialect CI only): DB__URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/hei_fastapi
## Redis for API cache / config sync. If requirepass: redis://:password@127.0.0.1:6379/0
#REDIS__URL=redis://127.0.0.1:6379/0
#
## In-memory job scheduler (sys_job table): scan interval ms & max concurrent jobs.
## HEI_JOB__SCAN_INTERVAL_MS=1000
## HEI_JOB__POOL_SIZE=4
